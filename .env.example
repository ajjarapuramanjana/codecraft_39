# Copy to .env and set a long random secret before deployment
SECRET_KEY=replace-with-a-long-random-secret
PORT=5000
FLASK_DEBUG=0

# Optional AI analysis. Leave blank to use rule-based analyzer.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional database path; default is database/phishguard.db
# DATABASE_PATH=
